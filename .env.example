# ==============================================================================
# Publishing Studio Environment Configuration
# ==============================================================================

# 1. Stealth Path Configuration
# The secret URL segment where the admin studio will live.
# E.g. If set to "studio-core-99", the studio is reached at /studio-core-99
ADMIN_SECRET_SLUG="studio-core-99"

# 2. Stealth Gate Key
# The secret query key required to open the login portal.
# Without this key (?key=your-key), the URL returns a clean 404 (pretending it doesn't exist).
# E.g. https://bilalyazicioglu.com/studio-core-99?key=alpha-7729-gate
ADMIN_ACCESS_KEY="alpha-7729-gate"

# 3. Primary Authentication Credentials
ADMIN_USERNAME="bilal"
ADMIN_PASSWORD="super-strong-random-password-here"

# 4. Additional Static Security PIN
# Additional knowledge-based credential; not multi-factor authentication
ADMIN_SECURITY_PIN="9482"

# 5. Session Cryptographic Secret
# 64-character random string for HMAC-SHA256 session token signatures
# Generate via: node -e "console.log(crypto.randomBytes(32).toString('hex'))"
ADMIN_SESSION_SECRET="change-this-to-a-secure-64-character-random-hex-string-for-production"

# 6. Optional: Content Directory Path (Defaults to src/content/blog)
# BLOG_DIR_PATH=/app/content/blog

