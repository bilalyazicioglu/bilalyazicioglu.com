{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "bilal-blog",
  "main": "src/cloudflare/worker.ts",
  "compatibility_date": "2026-10-28",
  "workers_dev": true,
  "routes": [],
  "assets": {
    "directory": "./out",
    "binding": "ASSETS",
    "run_worker_first": true,
    "html_handling": "none",
    "not_found_handling": "404-page"
  }
}
